# .htaccess for Apache / Denwer / OpenServer
RewriteEngine On

# If request is for an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean HTML route rewrites for Apache/Denwer
RewriteRule ^login/?$ login.html [L]
RewriteRule ^register/?$ register.html [L]
RewriteRule ^chats/?$ chats.html [L]
RewriteRule ^friends/?$ friends.html [L]
RewriteRule ^profile/?$ profile.html [L]
RewriteRule ^communities/?$ communities.html [L]
RewriteRule ^community/?$ community.html [L]
RewriteRule ^community/settings/?$ community_settings.html [L]
RewriteRule ^new_community/?$ new_community.html [L]
RewriteRule ^settings/?$ settings.html [L]
RewriteRule ^support/?$ support.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^audios/?$ audios.html [L]

# Proxy API requests to Node.js backend if running under Apache/Denwer Reverse Proxy
<IfModule mod_proxy.c>
    ProxyPass /api http://127.0.0.1:3000/api
    ProxyPassReverse /api http://127.0.0.1:3000/api
</IfModule>
